# SmartStudy AI — Environment Variables
# Get a FREE Groq API key at: https://console.groq.com

# REQUIRED: Groq API key
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL overrides — models available on your account:
# GROQ_MODEL=openai/gpt-oss-120b   # default — best quality
# GROQ_MODEL=openai/gpt-oss-20b    # faster / lower latency
# GROQ_MODEL=qwen/qwen3.8-27b      # alternative mid-size model
# SECRET_KEY=change-this-random
# DEBUG=True
